#include <bits/stdc++.h>
using namespace std;

long long helper(long long l, long long m, long long r, long long t){
    
    m=(l+r)/2;
    
    if(l<=r){
        if(m*m==t) return m;
        if(m*m>t){
            r = m-1;
            return helper(l,m,r,t);
        }
        l = m+1;
        return helper(l,m,r,t);
    }
    return -1;
    
}

int main() {
	
	ios_base::sync_with_stdio(false);
	cin.tie(NULL);
	
	long long n;
	cin >> n;
	long long b, s;
	
	for(long long i=0;i<n;++i){
	    cin >> b;
	    long long sum=0;
	    for(long long j=0;j<b;++j){
	        cin >> s;
	        sum+=s;
	    }
	    
	    if(helper(0, 0, 2000000000, sum)==-1) cout << "NO" << "\n";
	    else cout << "YES" << "\n";
	    
	}
	
	return 0;
}
